generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Configuração única da imobiliária
model Config {
  id           Int    @id @default(1)
  imobiliaria  String
  lojaEndereco String
  lojaHorario  String
  whatsappLoja String
  diaRepasse   Int    @default(5)
}

model Membro {
  id        String     @id @default(cuid())
  nome      String
  papel     String // CORRETOR | ADMINISTRATIVO | FINANCEIRO | VISTORIA | GESTAO
  whatsapp  String
  cor       String
  ativo     Boolean    @default(true)
  tarefas   Tarefa[]
  contratos Contrato[] @relation("corretor")
  entregas  Contrato[] @relation("respEntrega")
  mensagens Mensagem[]
}

model Contrato {
  id              String     @id @default(cuid())
  codigo          String     @unique
  etapa           String // FICHA_APROVADA | CONTRATO_ASSINADO | VISTORIA | CHAVES_PRONTAS | ATIVO | DESOCUPACAO
  imovel          String
  endereco        String
  bairro          String
  valor           Int // em reais
  diaVencimento   Int        @default(10)
  inquilino       String
  inquilinoZap    String
  proprietario    String
  proprietarioZap String
  corretorId      String?
  corretor        Membro?    @relation("corretor", fields: [corretorId], references: [id])
  entregaData     String? // YYYY-MM-DD
  entregaHora     String?
  respEntregaId   String?
  respEntrega     Membro?    @relation("respEntrega", fields: [respEntregaId], references: [id])
  vistoriaData    String?
  vistoriaHora    String?
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt
  eventos         Evento[]
  mensagens       Mensagem[]
  tarefas         Tarefa[]
  lancamentos     Lancamento[]
  notas           NotaFiscal[]
  sinistros       Sinistro[]
  cobrancas       Cobranca[]
  documentos      Documento[]
  ficha           Ficha?
}

// Ficha digital completa — dados validados de locatário e proprietário
model Ficha {
  id         String    @id @default(cuid())
  contratoId String?   @unique
  contrato   Contrato? @relation(fields: [contratoId], references: [id])

  locNome        String
  locCpf         String
  locRg          String
  locNascimento  String
  locTelefone    String
  locEmail       String
  locEstadoCivil String
  locProfissao   String
  locEndereco    String

  propNome        String
  propCpf         String
  propRg          String
  propNascimento  String
  propTelefone    String
  propEmail       String
  propEstadoCivil String
  propProfissao   String
  propEndereco    String

  recebimento String // PIX | TRANSFERENCIA
  pixChave    String?
  banco       String?
  agencia     String?
  conta       String?

  imovelEndereco  String
  imovelBairro    String
  valor           Int
  diaVencimento   Int
  matricula       String
  temCondominio   Boolean @default(false)
  condominioValor Int?

  criadaEm DateTime @default(now())
}

// Pasta digital — documentos de inquilinos e proprietários
model Documento {
  id         String    @id @default(cuid())
  pessoa     String
  pessoaZap  String
  tipoPessoa String // INQUILINO | PROPRIETARIO
  tipo       String // RG_CNH | CPF | COMP_RENDA | COMP_RESIDENCIA | CERTIDAO | PROCURACAO | APOLICE_SEGURO | CONTRATO_ASSINADO
  rotulo     String
  status     String    @default("PENDENTE") // PENDENTE | RECEBIDO | APROVADO
  arquivo    String?
  recebidoEm DateTime?
  contratoId String?
  contrato   Contrato? @relation(fields: [contratoId], references: [id])
  criadoEm   DateTime  @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status])
}

// Esteira de cobrança de inadimplência
model Cobranca {
  id                 String    @id @default(cuid())
  inquilino          String
  imovel             String
  proprietario       String
  proprietarioZap    String
  valor              Int
  status             String // COBRANCA_INICIADA | AVISO_FORMAL | NEGOCIACAO | JURIDICO | REGULARIZADO
  previsaoPagamento  String? // YYYY-MM-DD
  iniciadaEm         DateTime  @default(now())
  atualizadoEm       DateTime  @updatedAt
  contratoId         String?
  contrato           Contrato? @relation(fields: [contratoId], references: [id])
}

// Sinistros de seguro-fiança (Loft / Porto Seguro)
model Sinistro {
  id              String    @id @default(cuid())
  seguradora      String // LOFT | PORTO
  tipo            String // INADIMPLENCIA | DANOS
  status          String // ABERTO | EM_ANALISE | DEFERIDO | PAGO
  protocolo       String
  previsaoDias    Int       @default(90)
  imovel          String
  proprietario    String
  proprietarioZap String
  abertoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt
  contratoId      String?
  contrato        Contrato? @relation(fields: [contratoId], references: [id])
}

// Contas a pagar e a receber
model Lancamento {
  id          String    @id @default(cuid())
  tipo        String // PAGAR | RECEBER
  descricao   String
  contraparte String
  categoria   String // ALUGUEL | REPASSE | FORNECEDOR | DESPESA | TAXA
  valor       Int // em reais
  vencimento  String // YYYY-MM-DD
  status      String    @default("ABERTO") // ABERTO | LIQUIDADO
  contratoId  String?
  contrato    Contrato? @relation(fields: [contratoId], references: [id])
  criadoEm    DateTime  @default(now())

  @@index([tipo, status, vencimento])
}

// NFS-e — nota fiscal de serviço (taxa de administração / intermediação)
model NotaFiscal {
  id          String    @id @default(cuid())
  numero      Int?      @unique
  competencia String // YYYY-MM
  tomador     String
  descricao   String
  valor       Int
  status      String    @default("EMITIDA") // EMITIDA | PENDENTE
  emitidaEm   DateTime  @default(now())
  contratoId  String?
  contrato    Contrato? @relation(fields: [contratoId], references: [id])
}

model Evento {
  id         String   @id @default(cuid())
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id])
  titulo     String
  criadoEm   DateTime @default(now())
}

model Tarefa {
  id            String    @id @default(cuid())
  titulo        String
  tipo          String // ENTREGA_CHAVE | VISTORIA | DESOCUPACAO | REPARO | ATENDIMENTO | OUTRO
  data          String // YYYY-MM-DD
  hora          String?
  concluida     Boolean   @default(false)
  responsavelId String
  responsavel   Membro    @relation(fields: [responsavelId], references: [id])
  contratoId    String?
  contrato      Contrato? @relation(fields: [contratoId], references: [id])
  criadoEm      DateTime  @default(now())
}

model Regra {
  id        String  @id @default(cuid())
  tipo      String  @unique
  grupo     String // DIARIO | INSTANTANEO
  nome      String
  descricao String
  destino   String // INQUILINO | PROPRIETARIO | EQUIPE
  hora      String?
  ativo     Boolean @default(true)
  template  String  @db.Text
  ordem     Int     @default(0)
}

model Mensagem {
  id         String    @id @default(cuid())
  regraTipo  String
  regraNome  String
  paraNome   String
  paraZap    String
  paraTipo   String // INQUILINO | PROPRIETARIO | EQUIPE
  conteudo   String    @db.Text
  status     String // SIMULADA | ENVIADA | ERRO
  origem     String // CRON | MANUAL | ETAPA | RECEPCAO
  dedupeKey  String?   @unique
  contratoId String?
  contrato   Contrato? @relation(fields: [contratoId], references: [id])
  membroId   String?
  membro     Membro?   @relation(fields: [membroId], references: [id])
  criadaEm   DateTime  @default(now())

  @@index([criadaEm])
}
