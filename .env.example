# Postgres (Neon) — use a URL pooled no DATABASE_URL e a direta no DIRECT_URL
DATABASE_URL="postgresql://usuario:senha@ep-xxx-pooler.regiao.aws.neon.tech/imobipro?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://usuario:senha@ep-xxx.regiao.aws.neon.tech/imobipro?sslmode=require"

# Segredo do cron diário (a Vercel envia como Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="troque-este-segredo"

# WhatsApp real via Evolution API (opcional — sem preencher, roda em modo demonstração)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""
